{
  "name": "sercom-active-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node scripts/catalog-preview.mjs dev",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "check": "npm run validate:catalog && astro check",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate:catalog && astro build",
    "build:preview": "npm run validate:catalog && node scripts/catalog-preview.mjs build",
    "preview": "astro preview"
  },
  "dependencies": { "astro": "7.4.13" },
  "devDependencies": { "@astrojs/check": "0.9.12", "typescript": "6.0.3" }
}
