---
// Sonda de compilación: caso que una página real NO debe repetir. Su script de navegador importa el módulo
// de datos; sirve para comprobar que, aun así, el archivo de ejemplos no entra en un script de producción.
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <title>Sonda de compilación: script con datos</title>
  </head>
  <body>
    <p id="total"></p>
    <script>
      import { products } from '../../../../src/lib/site-data.mjs';

      const total = document.getElementById('total');
      if (total) total.textContent = String(products.length);
    </script>
  </body>
</html>
