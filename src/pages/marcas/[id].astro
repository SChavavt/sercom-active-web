---
// Página de marca (/marcas/{id}/): una por cada marca de «Marcas que manejamos», en los dos modos.
// Bloque de título con el nombre como H1 (texto, nunca un logotipo) y, en la columna lateral, «Sitio del
// fabricante» (si la marca lo tiene; abre otra pestaña) y, solo con productos, la fila sólida «Contactar por
// WhatsApp». «Contactar por WhatsApp» aparece una sola vez en la página.
//   - Con productos: la misma barra lateral y retícula del catálogo (CatalogListing), con la marca marcada.
//   - Sin productos (hoy, todas): estado vacío con WhatsApp (la única acción de WhatsApp), «Marcas que
//     manejamos» con la marca actual marcada para pasar a otra, y la nota de disponibilidad. Sin productos y
//     sin sitio del fabricante el bloque de título no tiene celda lateral: el título ocupa la fila entera.
// Ninguna frase sobre la disponibilidad del portafolio de la marca ni sobre una relación con ella (R-CAT-12);
// un proveedor (`kind: supplier`) no recibe un texto distinto. Al final, la banda de solicitud especial.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActionRow from '../../components/ActionRow.astro';
import BrandCells from '../../components/BrandCells.astro';
import CatalogBand from '../../components/CatalogBand.astro';
import CatalogListing from '../../components/CatalogListing.astro';
import EmptyState from '../../components/EmptyState.astro';
import MoreLink from '../../components/MoreLink.astro';
import Note from '../../components/Note.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import { contactDetails, contactLinks } from '../../lib/contact.mjs';
import { brands, categories, getBrand, paths, productsByBrand, routes } from '../../lib/site-data.mjs';
import '../../styles/pages/catalogo.css';

export const getStaticPaths = (() => paths.brandIds.map(id => ({ params: { id } }))) satisfies GetStaticPaths;

const brand = getBrand(Astro.params.id ?? '');
if (!brand) throw new Error(`Marca desconocida: ${Astro.params.id}`);

const list = productsByBrand(brand.id);
const hasProducts = list.length > 0;
const whatsapp = contactLinks.brand(brand.name).whatsapp;
const description = `${brand.name}, una de las marcas que manejamos. ${contactDetails.locationLabel}.`;
const hasLinks = brand.manufacturerLinks.length > 0;
const crumbs = [{ label: 'Inicio', href: routes.home }, { label: 'Marcas', href: routes.brands }, { label: brand.name }];
---
<BaseLayout title={brand.name} description={description}>
  {hasLinks || hasProducts ? (
    <PageHeader title={brand.name} breadcrumbs={crumbs}>
      {hasLinks && (
        <div class="catalog-brand__links">
          {brand.manufacturerLinks.map(link => <MoreLink href={link.url} external>{link.label}</MoreLink>)}
        </div>
      )}
      {/* Sin productos, la única acción de WhatsApp es la del estado vacío de abajo. */}
      {hasProducts && <ActionRow href={whatsapp} primary icon="whatsapp">Contactar por WhatsApp</ActionRow>}
    </PageHeader>
  ) : (
    <PageHeader title={brand.name} breadcrumbs={crumbs} />
  )}

  {hasProducts ? (
    <CatalogListing products={list} categories={categories} brands={brands} currentBrandId={brand.id} />
  ) : (
    <Fragment>
      <EmptyState
        icon="package"
        title="Estamos cargando los productos de esta marca."
        text="Mientras tanto, dinos qué necesitas y te ayudamos a cotizarlo."
        action={{ href: whatsapp, label: 'Contactar por WhatsApp', icon: 'whatsapp' }}
      />
      <section class="section" aria-labelledby="marcas-title">
        <SectionHead title="Marcas que manejamos" id="marcas-title" />
        <BrandCells brands={brands} currentId={brand.id} allLink={{ href: routes.brands, label: 'Ver todas las marcas' }} />
        <Note>Disponibilidad por marca y modelo sujeta a confirmación al cotizar.</Note>
      </section>
    </Fragment>
  )}

  <CatalogBand />
</BaseLayout>
