---
import BaseLayout from '../layouts/BaseLayout.astro';
import business from '../data/business.json';
const whatsapp = `https://wa.me/${business.whatsappDigits}?text=${encodeURIComponent('Hola, Yosmara. Me interesa solicitar información y una cotización de Sercom Active.')}`;
---
<BaseLayout title="Sercom Active · Atención en Puebla" description="Atención comercial de Sercom Active en Puebla. Comparte tu requerimiento y revisaremos opciones para cotizar.">
  <div class="development-note">Sitio en preparación · Versión inicial para revisión</div>
  <header class="shell header">
    <a class="wordmark" href="/" aria-label="Sercom Active, inicio">Sercom<span>Active</span></a>
    <a href="#contacto">Contacto en Puebla <span aria-hidden="true">↗</span></a>
  </header>
  <main id="contenido" class="shell hero">
    <section class="intro">
      <p class="eyebrow">{business.locationLabel}</p>
      <h1>Equipo de protección y soluciones para tu empresa.</h1>
      <p class="lead">Cuéntanos qué necesitas. Te ayudamos a buscar opciones y preparar una cotización para tu requerimiento.</p>
      <a class="button" href={whatsapp} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp <span aria-hidden="true">↗</span></a>
      <p class="supporting">¿Buscas un producto o material especial? Comparte la descripción, marca o modelo y la cantidad que necesitas.</p>
    </section>
    <aside id="contacto" class="contact-card">
      <p class="eyebrow">Atención personal</p>
      <h2>{business.contactName}</h2>
      <div class="contact-item"><span>WhatsApp</span><a href={whatsapp} target="_blank" rel="noopener noreferrer">{business.whatsappDisplay}</a></div>
      <div class="contact-item"><span>Correo</span><a href={`mailto:${business.email}`}>{business.email}</a></div>
      <div class="contact-item"><span>Horario · Puebla</span><p>{business.hoursText}</p></div>
      <p class="contact-footnote">Disponibilidad y tiempo de entrega sujetos a confirmación al cotizar.</p>
    </aside>
  </main>
  <section class="shell next-step" aria-labelledby="catalogo-en-preparacion">
    <p class="eyebrow">Próximamente</p>
    <h2 id="catalogo-en-preparacion">Un catálogo para explorar nuestras opciones.</h2>
    <p>Estamos preparando la consulta por categorías y marcas. Mientras tanto, podemos atender tu solicitud directamente.</p>
  </section>
  <footer class="shell footer"><strong>{business.name}</strong><span>Atención comercial en Puebla</span></footer>
</BaseLayout>
