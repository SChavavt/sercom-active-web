---
// Página no encontrada (versión simple). Se muestra en cualquier dirección: todos los enlaces son absolutos.
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionRow from '../components/ActionRow.astro';
import PageHeader from '../components/PageHeader.astro';
import { routes } from '../lib/site-data.mjs';
---
<BaseLayout title="Página no encontrada" description="La página que buscas no existe. Regresa al inicio de Sercom Active.">
  <PageHeader title="No encontramos esta página." eyebrow="Error 404">
    <ActionRow href={routes.home} primary>Volver al inicio</ActionRow>
    <ActionRow href={routes.catalog}>Explorar catálogo</ActionRow>
  </PageHeader>
</BaseLayout>
