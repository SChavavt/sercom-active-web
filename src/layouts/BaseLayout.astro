---
// Plantilla de todas las páginas: <head> común (idioma es-MX, título, descripción, noindex, canónica solo
// si se conoce la dirección del sitio y nunca en la 404, iconos, precarga de la fuente), enlace «Saltar al
// contenido», el aviso de arriba (SiteNotice: el de vista previa en esa compilación; en producción, el de sitio en
// preparación hasta el lanzamiento), la lámina con encabezado, <main id="contenido"> y pie, y la barra fija del
// celular. Importa la hoja global una sola vez.
//
// Uso:  <BaseLayout title="Catálogo" description="…"> …bloques de la página… </BaseLayout>
// El contenido va directo dentro de <main>: cada bloque es una fila de la lámina (ver docs/diseno.md).
import '../styles/global.css';
import fontLatin from '../assets/fonts/archivo-latin-wdth-normal.woff2?url';
import { contactDetails } from '../lib/contact.mjs';
import { isPreview } from '../lib/site-data.mjs';
import Dock from '../components/Dock.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteNotice from '../components/SiteNotice.astro';

interface Props {
  /** Nombre de la página («Catálogo»). El título queda «Catálogo · Sercom Active». Sin él: el de la portada,
   *  «Sercom Active · Atención en Puebla» (nombre y `titleLabel` de business.json). */
  title?: string;
  /** Descripción para buscadores y vistas previas de enlaces. Por omisión, la de la empresa. */
  description?: string;
  /** `false` en la página 404: el servidor la entrega en cualquier dirección desconocida, así que nunca declara
   *  una dirección canónica. Las demás páginas la llevan cuando se conoce la dirección del sitio (SITE_URL). */
  canonical?: boolean;
}

const { businessName, locationLabel, titleLabel } = contactDetails;
const {
  title,
  description = `Venta, entrega y asesoría de productos de seguridad industrial. ${locationLabel}.`,
  canonical: hasCanonical = true,
} = Astro.props;
const pageTitle = title ? `${title} · ${businessName}` : `${businessName} · ${titleLabel}`;
const canonical = hasCanonical && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {/* El sitio no está lanzado: ninguna página se indexa (se retira a propósito al publicar, junto con el aviso
        de sitio en preparación de abajo). */}
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {isPreview && <SiteNotice kind="preview" />}
    {/* El sitio no está lanzado: cada página de producción lleva el aviso «Sitio en preparación» (se retira a
        propósito al publicar, junto con el noindex de arriba: se borra esta línea; la vista previa conserva el suyo). */}
    {!isPreview && <SiteNotice kind="development" />}
    <div class="sheet">
      <SiteHeader />
      <main id="contenido" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <Dock />
  </body>
</html>
