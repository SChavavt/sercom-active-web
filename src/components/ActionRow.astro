---
// Fila de acción (`.action`): ocupa toda una fila de la lámina, con el texto a la izquierda y una flecha (u otro
// icono) a la derecha. `primary` la pinta de azul sólido (la decisión principal del bloque).
// Va dentro de una columna de celdas (por ejemplo la columna lateral de PageHeader o de la portada).
//   - Con `href` es un enlace <a>, con los atributos que reciba (como siempre).
//   - Con `type` y sin `href` es un <button> con el mismo dibujo: `type="button"` si lo atiende un script de la
//     página, `type="submit"` si envía su formulario. Úsalo solo en esos dos casos: el botón lleva su propio gancho
//     `data-*` (que el script de la página nombra) y recibe todos los demás atributos (`data-*`, `aria-*`, `id`,
//     `hidden`). Con aria-disabled="true" se ve apagado y no cambia al pasar el puntero; el script decide qué hace (o
//     no hace) un clic.
// Hay que escribir uno de los dos, `href` o `type`, y nunca los dos; los tipos lo exigen. Así un `href` que puede
// faltar (`href={marca.sitio}` con un dato opcional) no pasa `npm run check`, y un enlace sin destino nunca se vuelve
// en silencio un botón que no hace nada.
//
// Uso:
//   <ActionRow href={routes.catalog}>Explorar catálogo</ActionRow>
//   <ActionRow type="submit" icon="clipboard-plus">Agregar a mi cotización</ActionRow>
//   <ActionRow type="button" icon="copy" data-copy-request>Copiar solicitud</ActionRow>
import type { HTMLAttributes } from 'astro/types';
import type { IconName } from '../lib/icons.ts';
import Icon from './Icon.astro';

interface Shared extends Omit<HTMLAttributes<'a'>, 'type' | 'href'> {
  primary?: boolean;
  /** Icono final; por omisión una flecha. */
  icon?: IconName;
}
/** Un enlace: `href` es un texto, nunca `undefined`. */
interface AsLink extends Shared {
  href: string;
  type?: never;
}
/** Un botón: sin `href` y con `type` escrito. */
interface AsButton extends Shared {
  href?: never;
  /** `button` (lo atiende un script de la página) o `submit` (envía su formulario). */
  type: 'button' | 'submit';
}
type Props = AsLink | AsButton;

const { href, primary = false, icon = 'arrow-right', type = 'button', class: className, ...attrs } = Astro.props;
const classes = ['action', 'cell-link', { 'action--primary': primary }, className];
---
{href !== undefined ? (
  <a class:list={classes} href={href} {...(attrs as HTMLAttributes<'a'>)}><span><slot /></span><Icon name={icon} class="icon--24" /></a>
) : (
  <button class:list={classes} type={type} {...(attrs as HTMLAttributes<'button'>)}><span><slot /></span><Icon name={icon} class="icon--24" /></button>
)}
