---
// Tarjeta de producto (`.product`) a partir de un PublicProduct:
//   fotografía (ProductPhoto; o, sin ella, el pictograma de la categoría sobre el rayado), etiqueta «Ejemplo» si es un
//   ejemplo de la vista previa, categoría, nombre, marca y código, «Ver ficha» (toda la tarjeta lleva a la
//   ficha) y «Cotizar», que abre WhatsApp con el mensaje de producto de contactLinks.product.
// El separador «·» va unido a la marca con un espacio de no separación (dentro de su elemento, que el celular
// oculta junto con él): el renglón solo puede partirse después del separador, nunca empezar con «·».
// Las dos acciones llevan su nombre completo en aria-label («Ver ficha: {nombre}», «Cotizar: {nombre}»): leído de
// su contenido, el navegador pone un espacio antes del sufijo oculto («Ver ficha : …»). El sufijo oculto se queda
// para quien lea el texto de la página.
// Abrir WhatsApp no es un envío: ninguna página muestra confirmaciones.
// Mientras el sitio no tenga dirección pública (SITE_URL), el mensaje se arma sin la línea «Enlace» y el
// script compartido PageLinkScript la agrega al cargar la página, con la dirección de la ficha en el sitio donde
// se está viendo (la ficha de producto usa el mismo script para sus enlaces).
import type { PublicProduct } from '../types/site.ts';
import { absoluteUrl, contactLinks } from '../lib/contact.mjs';
import { EXAMPLE_TAG } from '../lib/site-data.mjs';
import { categoryIcon } from '../lib/icons.ts';
import Icon from './Icon.astro';
import PageLinkScript from './PageLinkScript.astro';
import ProductPhoto from './ProductPhoto.astro';
import Tag from './Tag.astro';

interface Props {
  product: PublicProduct;
  /** Nivel del nombre del producto; 3 por omisión (bajo el H2 de la sección). */
  headingLevel?: 2 | 3 | 4;
  /** Clases de columna, por ejemplo `span-3` (ProductGrid las pone). */
  class?: string;
}

const { product, headingLevel = 3, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const pageUrl = absoluteUrl(product.url, Astro.site);
const quote = contactLinks.product({ brandName: product.brandName, code: product.code, name: product.name, url: pageUrl });
const categoryName = product.categoryNames[0];
const categoryId = product.categoryIds[0];
---
<article class:list={['product', className]}>
  <div class:list={['product__media', { 'product__media--photo': product.image }]}>
    {product.isExample && <Tag>{EXAMPLE_TAG}</Tag>}
    {product.image ? (
      <ProductPhoto image={product.image} place="card" class="product__img" productId={product.id} />
    ) : (
      <span class="product__plate"><Icon name={categoryIcon(categoryId ?? '')} class="icon--fine" /></span>
    )}
  </div>
  <div class="product__body">
    {categoryName && <p class="product__cat label">{categoryName}</p>}
    <Heading class="product__name t-h3">{product.name}</Heading>
    <p class="product__meta t-small">{product.brandName}<span class="sep" aria-hidden="true">&nbsp;·</span> <span class="t-code">{product.code}</span></p>
  </div>
  <div class="product__actions">
    <a class="product__action product__action--sheet" href={product.url} aria-label={`Ver ficha: ${product.name}`}><span>Ver ficha<span class="vh">: {product.name}</span></span><Icon name="arrow-right" class="icon--18" /></a>
    <a class="product__action product__action--quote" href={quote.whatsapp} data-page-link={pageUrl ? undefined : product.url} aria-label={`Cotizar: ${product.name}`}><span>Cotizar<span class="vh">: {product.name}</span></span><Icon name="whatsapp" class="icon--18" /></a>
  </div>
</article>

<PageLinkScript />
