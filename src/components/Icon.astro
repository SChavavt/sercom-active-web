---
// Icono del kit (src/assets/icons/icons.json) impreso como SVG en línea: hereda el color del texto
// (`currentColor`) y solo los iconos que una página usa llegan a su HTML.
// Lleva width y height (16, 18, 24 o 28 según su clase icon--N; 20 por omisión).
// Decorativo por omisión (aria-hidden y focusable="false"). Con `label` se anuncia como imagen con ese nombre:
// úsalo solo cuando el icono es el único contenido de un control o transmite información por sí mismo.
import type { HTMLAttributes } from 'astro/types';
import { getIcon, type IconName } from '../lib/icons.ts';

interface Props extends Omit<HTMLAttributes<'svg'>, 'name'> {
  /** Nombre del kit, por ejemplo `arrow-right`, `whatsapp` o `cat-manos`. */
  name: IconName;
  /** Tamaño y peso: `icon--16`, `icon--18`, `icon--24`, `icon--28` (20 px por omisión), `icon--art`, `icon--fine`. */
  class?: string;
  /** Nombre accesible. Sin él, el icono es decorativo. */
  label?: string;
}

const { name, class: className, label, ...attrs } = Astro.props;
const icon = getIcon(name);
// Tamaño en atributos, el mismo que da la hoja de estilo a su clase (base.css): si la hoja no llega, el icono
// conserva su tamaño en lugar de crecer al ancho de la página. Con la hoja, el CSS manda. Los atributos que pase
// quien lo usa ganan.
const size = Number(/(?:^|\s)icon--(16|18|24|28)(?:\s|$)/.exec(className ?? '')?.[1] ?? 20);
---
{label ? (
  <svg class:list={['icon', className]} viewBox={icon.viewBox} width={size} height={size} role="img" aria-label={label} focusable="false" {...attrs} set:html={icon.body} />
) : (
  <svg class:list={['icon', className]} viewBox={icon.viewBox} width={size} height={size} aria-hidden="true" focusable="false" {...attrs} set:html={icon.body} />
)}
