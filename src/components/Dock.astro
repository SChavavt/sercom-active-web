---
// Barra fija del celular (`.dock`): «Cotizar mi lista» y WhatsApp siempre a mano, en dos celdas.
// Solo se ve por debajo de 700 px; el cuerpo de la página reserva su alto para que no tape contenido.
import { contactLinks } from '../lib/contact.mjs';
import { routes } from '../lib/site-data.mjs';
import Icon from './Icon.astro';
---
<nav class="dock" aria-label="Acciones rápidas">
  <a class="dock__link" href={routes.quoteList}><Icon name="clipboard-list" /><span>Cotizar mi lista</span></a>
  <a class="dock__link dock__link--wa" href={contactLinks.general().whatsapp}><Icon name="whatsapp" /><span>WhatsApp</span></a>
</nav>
