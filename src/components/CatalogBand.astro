---
// Banda de solicitud especial al final del catálogo, de las páginas de categoría y de marca y de la página de un
// producto retirado: «¿Buscas algo que no aparece en el catálogo?» → «Ayúdame a encontrarlo». Bajo su texto, en el
// lugar que Band deja para eso, el enlace «Ver los catálogos de los fabricantes» a la sección de /marcas/, solo cuando
// esa sección existe (alguna marca tiene un catálogo del fabricante). /marcas/ no usa esta banda: la sección está justo
// arriba de la suya.
// Uso:  <CatalogBand />   (una por página: el id del título es fijo)
import { brands, routes } from '../lib/site-data.mjs';
import Band from './Band.astro';
import Icon from './Icon.astro';

const hasCatalogs = brands.some(brand => brand.hasCatalog);
---
<section class="section" aria-labelledby="especial-title">
  <Band
    title="¿Buscas algo que no aparece en el catálogo?"
    id="especial-title"
    text="Envíanos una descripción, foto, marca o modelo y la cantidad que necesitas. Revisaremos opciones para conseguirlo y cotizarlo."
    action={{ href: routes.specialRequest, label: 'Ayúdame a encontrarlo' }}
  >
    {hasCatalogs && <a class="band__link" href={routes.brandCatalogs}><span>Ver los catálogos de los fabricantes</span><Icon name="arrow-right" /></a>}
  </Band>
</section>
