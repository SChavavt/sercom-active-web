---
// Estado vacío (`.empty`): una celda de ancho completo con un pictograma de línea, dos frases y una
// acción. Para una búsqueda sin resultados y para una categoría o una marca sin productos:
//   «No encontramos productos con esa búsqueda.» / «Puedes pedirnos este producto y lo buscamos por ti.»
//     → Solicitar este producto
//   «Los productos de esta categoría no están en este catálogo.» / «Dinos qué necesitas y te ayudamos a
//     cotizarlo.» → botón de WhatsApp
//   «Los productos de esta marca no están en este catálogo.» / «Consulta el catálogo del fabricante y dinos qué
//     modelo necesitas: te ayudamos a cotizarlo.» (si la marca publica su catálogo) o «Dinos qué necesitas y te
//     ayudamos a cotizarlo.» → botón de WhatsApp
// Una categoría o una marca sin productos no promete que vayan a llegar.
// Slot `extra` (opcional): una segunda acción, después de la principal (el catálogo pone ahí «Limpiar filtros»).
// Con él, las dos acciones van juntas en `.empty__actions` (catalogo.css): una sobre otra en computadora, lado a
// lado si caben en tableta y a todo lo ancho en el celular. Sin él, el marcado es el de siempre.
import type { IconName } from '../lib/icons.ts';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  /** Pictograma de línea (64 px); por ejemplo `search`, `zoom-question` o el de la categoría. */
  icon: IconName;
  /** Primera frase: lo que pasa. */
  title: string;
  /** Segunda frase: qué puede hacer la persona. */
  text: string;
  action: { href: string; label: string; icon?: IconName };
  /** Nivel de la primera frase; 2 por omisión. */
  headingLevel?: 2 | 3;
  class?: string;
}

const { icon, title, text, action, headingLevel = 2, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const hasExtra = Astro.slots.has('extra');
---
<div class:list={['empty', className]}>
  <Icon name={icon} class="empty__icon icon--fine" />
  <div class="empty__body">
    <Heading class="empty__title">{title}</Heading>
    <p class="empty__text">{text}</p>
  </div>
  {hasExtra ? (
    <div class="empty__actions">
      <Button class="empty__action" href={action.href} icon={action.icon} iconEnd={action.icon ? undefined : 'arrow-right'}>{action.label}</Button>
      <slot name="extra" />
    </div>
  ) : (
    <Button class="empty__action" href={action.href} icon={action.icon} iconEnd={action.icon ? undefined : 'arrow-right'}>{action.label}</Button>
  )}
</div>
